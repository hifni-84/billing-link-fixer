[Unit]
Description=NBS - pemeriksaan otomatis RADIUS dan layanan billing
After=network-online.target mariadb.service mysql.service freeradius.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mikrotik-billing
ExecStart=/bin/bash /opt/mikrotik-billing/deploy/autoheal-check.sh
StandardOutput=append:/var/log/billing-autoheal.log
StandardError=append:/var/log/billing-autoheal.log
TimeoutStartSec=60
