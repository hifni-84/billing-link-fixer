[Unit]
Description=Periksa kesehatan NBS saat boot dan setiap 15 menit

[Timer]
# 1 menit setelah server hidup (mis. setelah mati lampu)
OnBootSec=60
# lalu cek ulang setiap 15 menit tanpa restart bila layanan sehat
OnUnitActiveSec=15min
Persistent=true
Unit=billing-autoheal.service

[Install]
WantedBy=timers.target
